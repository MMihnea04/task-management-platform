            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "http://localhost:8080/api/users/me", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "users", "me"]}
          }
        },
        {
          "name": "Update My Profile",
