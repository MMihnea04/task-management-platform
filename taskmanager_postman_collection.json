            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {
              "raw": "http://localhost:8080/api/users/me?firstName=Ion&lastName=Popescu",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "users", "me"],
              "query": [
                {"key": "firstName", "value": "Ion"},
                {"key": "lastName", "value": "Popescu"}
              ]
